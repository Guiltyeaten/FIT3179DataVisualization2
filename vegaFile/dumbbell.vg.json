{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 780,
  "height": 560,
  "padding": {"right": 5, "left": 5},
  "title": {
    "text": "Gender pay gap by field of study",
    "subtitle": "Undergraduate 2025 · sorted by size of gap (largest at top)"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/salary_by_area.csv",
    "format": {
      "type": "csv",
      "parse": {"year": "number", "median_salary": "number"}
    }
  },
  "transform": [
    {"filter": "datum.year == 2025 && datum.course_level == 'UG' && datum.study_area_level == 'broad' && (datum.gender == 'Male' || datum.gender == 'Female')"},
    {"pivot": "gender", "value": "median_salary", "groupby": ["study_area"]},
    {"filter": "isValid(datum.Male) && isValid(datum.Female)"},
    {"calculate": "datum.Male - datum.Female", "as": "gapAbs"},
    {"calculate": "(datum.Male - datum.Female) / datum.Male * 100", "as": "gapPct"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2.5, "color": "#b0b5bd"},
      "encoding": {
        "y": {
          "field": "study_area",
          "type": "nominal",
          "sort": {"field": "gapPct", "order": "descending"},
          "title": null,
          "axis": {"labelLimit": 320, "labelFontSize": 11.5}
        },
        "x": {"field": "Female", "type": "quantitative"},
        "x2": {"field": "Male"},
        "tooltip": [
          {"field": "study_area", "type": "nominal", "title": "Field"},
          {"field": "Male", "type": "quantitative", "format": "$,.0f", "title": "Male median"},
          {"field": "Female", "type": "quantitative", "format": "$,.0f", "title": "Female median"},
          {"field": "gapAbs", "type": "quantitative", "format": "$,.0f", "title": "Gap ($)"},
          {"field": "gapPct", "type": "quantitative", "format": ".1f", "title": "Gap (%)"}
        ]
      }
    },
    {
      "transform": [
        {"fold": ["Male", "Female"], "as": ["gender", "salary"]}
      ],
      "mark": {"type": "point", "filled": true, "size": 140, "opacity": 1, "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "y": {
          "field": "study_area",
          "type": "nominal",
          "sort": {"field": "gapPct", "order": "descending"}
        },
        "x": {
          "field": "salary",
          "type": "quantitative",
          "title": "Median starting salary (AUD)",
          "scale": {"zero": false, "domain": [55000, 100000]},
          "axis": {"format": "$,.0f", "titleFontSize": 12, "labelFontSize": 11}
        },
        "color": {
          "field": "gender",
          "type": "nominal",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#1e88e5", "#e53935"]
          },
          "legend": {
            "title": "Median salary for",
            "orient": "top",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 12,
            "symbolSize": 120,
            "symbolType": "circle"
          }
        },
        "tooltip": [
          {"field": "study_area", "type": "nominal", "title": "Field"},
          {"field": "Male", "type": "quantitative", "format": "$,.0f", "title": "Male median"},
          {"field": "Female", "type": "quantitative", "format": "$,.0f", "title": "Female median"},
          {"field": "gapAbs", "type": "quantitative", "format": "$,.0f", "title": "Gap ($)"},
          {"field": "gapPct", "type": "quantitative", "format": ".1f", "title": "Gap (%)"}
        ]
      }
    }
  ]
}