{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 480,
  "title": {"text": "Employment composition by field", "subtitle": "Undergraduate 2025 · widths proportional to full-time employment rate"},
  "data": {"url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/refs/heads/main/processedData/employment_by_area.csv"},
  "transform": [
    {"filter": "datum.year==2025 && datum.course_level=='UG' && datum.study_area_level=='broad'"},
    {"aggregate": [{"op": "sum", "field": "median_salary", "as": "sal"}], "groupby": ["study_area"]},
    {"joinaggregate": [{"op": "sum", "field": "sal", "as": "tot"}]},
    {"calculate": "datum.sal / datum.tot", "as": "w"},
    {"stack": "w", "as": ["x0", "x1"], "groupby": []},
    {"stack": "sal", "as": ["y0", "y1"], "groupby": ["study_area"]}
  ],
  "mark": {"type": "rect", "stroke": "white"},
  "encoding": {
    "x": {"field": "x0", "type": "quantitative", "axis": null},
    "x2": {"field": "x1"},
    "y": {"field": "y0", "type": "quantitative", "axis": null},
    "y2": {"field": "y1"},
    "color": {"field": "study_area", "type": "nominal", "legend": null},
    "tooltip": [{"field": "study_area"}, {"field": "sal", "format": "$,.0f"}]
  }
}