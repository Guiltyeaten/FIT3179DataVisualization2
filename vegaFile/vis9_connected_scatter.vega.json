{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 420,
  "title": {"text": "Salary vs full-time employment", "subtitle": "Undergraduate · each line traces one field over 2020–2025"},
  "data": {"url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/refs/heads/main/processedData/salary_vs_fte.csv"},
  "transform": [
    {"lookup": "study_area",
     "from": {"data": {"url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/refs/heads/main/processedData/salary_by_area.csv"}, "key": "study_area",
              "fields": ["median_salary"]}}
  ],
  "mark": {"type": "line", "strokeWidth": 1.5, "opacity": 0.7},
  "encoding": {
    "x": {"field": "fte", "type": "quantitative", "title": "Full-time employment rate (%)", "scale": {"zero": false}},
    "y": {"field": "median_salary", "type": "quantitative", "title": "Median starting salary (AUD)",
          "scale": {"zero": false}, "axis": {"format": "$,.0f"}},
    "color": {"field": "study_area", "type": "nominal", "legend": {"labelLimit": 260}},
    "detail": {"field": "study_area"},
    "order": {"field": "year", "type": "ordinal"},
    "tooltip": [
      {"field": "study_area"}, {"field": "year"},
      {"field": "fte", "format": ".1f"}, {"field": "median_salary", "format": "$,.0f"}
    ]
  }
}