{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Full-time employment rate by university",
    "subtitle": ["Undergraduate · 2025 · bubble size = full-time employment rate"],
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#546e7a",
    "anchor": "start",
    "offset": 12
  },
  "width": "container",
  "height": 550,
  "params": [
    {
      "name": "cityView",
      "value": "Australia",
      "bind": {
        "input": "select",
        "name": "Zoom to: ",
        "options": ["Australia", "Sydney", "Melbourne", "Brisbane", "Perth", "Adelaide", "Canberra", "Hobart", "Darwin"]
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "cityView === 'Sydney' ? [151.20, -33.90] : cityView === 'Melbourne' ? [144.96, -37.81] : cityView === 'Brisbane' ? [153.02, -27.47] : cityView === 'Perth' ? [115.86, -31.95] : cityView === 'Adelaide' ? [138.60, -34.93] : cityView === 'Canberra' ? [149.13, -35.28] : cityView === 'Hobart' ? [147.33, -42.88] : cityView === 'Darwin' ? [130.84, -12.46] : [134.00, -28.00]"
    },
    "scale": {
      "expr": "cityView === 'Australia' ? 700 : cityView === 'Canberra' ? 40000 : cityView === 'Sydney' ? 80000 : cityView === 'Adelaide' ? 80000 : cityView === 'Hobart' ? 40000 : cityView === 'Darwin' ? 35000 : 25000"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/Data/SA4_2026_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "SA4_2026_AUST_GDA2020"}
      },
      "mark": {"type": "geoshape", "fill": "#f4f6f9", "stroke": "#d4d9e0", "strokeWidth": 0.3}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/institution_outcomes.csv"
      },
      "transform": [
        {"filter": "datum.year == 2025 && datum.course_level == 'UG'"},
        {"filter": "datum.metric == 'salary' || datum.metric == 'fte'"},
        {"pivot": "metric", "value": "value", "groupby": ["institution", "year", "course_level"]},
        {"filter": "isValid(datum.salary) && isValid(datum.fte)"},
        {
          "lookup": "institution",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/Data/university_coords.csv"
            },
            "key": "institution",
            "fields": ["lon", "lat", "city", "state"]
          }
        },
        {"filter": "isValid(datum.lon) && isValid(datum.lat)"}
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.55,
        "stroke": "#4c99ea",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "fte",
          "type": "quantitative",
          "title": "Full-time employment rate (%)",
          "scale": {"type": "linear", "domain": [70, 90], "range": [30, 500]},
          "legend": {
            "orient": "bottom-left",
            "format": ".0f",
            "values": [70, 80, 90],
            "title": "Full-time employment rate (%)",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "institution", "type": "nominal", "title": "University"},
          {"field": "city", "type": "nominal", "title": "City"},
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "fte", "type": "quantitative", "format": ".1f", "title": "FTE rate (%)"},
          {"field": "salary", "type": "quantitative", "format": "$,.0f", "title": "Median salary"}
        ]
      }
    }
  ]
}