{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Graduate starting salaries across Australian universities",
    "subtitle": "Undergraduate · 2025 · colour = median starting salary · source: QILT GOS"
  },
  "width": 500,
  "height": 550,
  "projection": {"type": "mercator", "center": [134, -28], "scale": 700},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/Data/SA4_2026_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "SA4_2026_AUST_GDA2020"}
      },
      "mark": {"type": "geoshape", "fill": "#f4f6f9", "stroke": "#d4d9e0", "strokeWidth": 0.3}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/institution_outcomes.csv"
      },
      "transform": [
        {"filter": "datum.year == 2025 && datum.course_level == 'UG' && datum.metric == 'salary'"},
        {
          "lookup": "institution",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/Data/university_coords.csv"
            },
            "key": "institution",
            "fields": ["lon", "lat", "city"]
          }
        },
        {"filter": "isValid(datum.lon) && isValid(datum.lat)"}
      ],
      "mark": {
        "type": "circle",
        "size": 50,
        "opacity": 0.9,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "Median starting salary (AUD)",
          "scale": {
            "type": "linear",
            "domain": [67000, 88000],
            "scheme": "reds"
          },
          "legend": {
            "orient": "top-left",
            "format": "$,.0f",
            "values": [68000, 72000, 76000, 80000, 84000, 88000],
            "gradientLength": 200,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "institution", "type": "nominal", "title": "University"},
          {"field": "city", "type": "nominal", "title": "City"},
          {"field": "value", "type": "quantitative", "format": "$,.0f", "title": "Median UG salary"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/institution_outcomes.csv"
      },
      "transform": [
        {"filter": "datum.year == 2025 && datum.course_level == 'UG' && datum.metric == 'salary'"},
        {"filter": "datum.institution === 'University of New England' || datum.institution === 'Torrens University'"},
        {
          "lookup": "institution",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/Data/university_coords.csv"
            },
            "key": "institution",
            "fields": ["lon", "lat"]
          }
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1a1a1a",
        "dy": -20,
        "align": "center"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "value", "type": "quantitative", "format": "$,.0f"}
      }
    }
  ]
}