{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Median salary by detailed field and gender, 2025",
  "data": {"url": "data/salary_by_area.csv"},
  "transform": [
    {"filter": "year == 2025 && course_level == 'UG' && study_area_level == 'detail45' && gender != 'Total'"}
  ],
  "mark": {"type": "rect"},
  "encoding": {
    "y": {"field": "study_area", "type": "nominal", "title": null,
          "axis": {"labelFontSize": 9}},
    "x": {"field": "gender", "type": "nominal", "title": null,
          "axis": {"labelAngle": 0}},
    "color": {"field": "median_salary", "type": "quantitative",
              "scale": {"scheme": "viridis"},
              "title": "Median salary (AUD)"},
    "tooltip": [
      {"field": "study_area", "type": "nominal"},
      {"field": "gender", "type": "nominal"},
      {"field": "median_salary", "type": "quantitative", "format": "$,.0f"}
    ]
  },
  "width": 180, "height": 720
}