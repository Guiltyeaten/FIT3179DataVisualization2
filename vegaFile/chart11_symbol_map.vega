{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Median graduate salary by university, 2025",
  "width": 520, "height": 420,
  "projection": {"type": "mercator"},
  "layer": [
    {"data": {"url": "data/sa4_topojson.json",
              "format": {"type": "topojson", "feature": "SA4_2021_AUST_GDA2020"}},
     "mark": {"type": "geoshape", "fill": "#f0f0f0",
              "stroke": "#cccccc", "strokeWidth": 0.2}},
    {"data": {"url": "data/institution_ug_geo.csv"},
     "transform": [
       {"filter": "year == 2025 && course_level == 'UG' && metric == 'salary'"}
     ],
     "mark": {"type": "circle", "opacity": 0.7,
              "stroke": "white", "strokeWidth": 0.5},
     "encoding": {
       "longitude": {"field": "lon", "type": "quantitative"},
       "latitude": {"field": "lat", "type": "quantitative"},
       "size": {"field": "value", "type": "quantitative",
                "scale": {"range": [30, 500]},
                "title": "Median salary (AUD)"},
       "tooltip": [
         {"field": "institution", "type": "nominal"},
         {"field": "value", "type": "quantitative", "format": "$,.0f"}
       ]
     }}
  ]
}