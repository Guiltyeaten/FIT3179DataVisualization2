{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Median salary by citizenship, 2016–2024",
  "data": {"url": "data/international_trend.csv"},
  "transform": [
    {"filter": "course_level == 'UG'"}
  ],
  "mark": {"type": "line", "strokeWidth": 2.5, "point": true},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "title": null,
          "axis": {"labelAngle": 0}},
    "y": {"field": "median_salary", "type": "quantitative",
          "title": "Median salary (AUD)", "axis": {"format": "$,.0f"},
          "scale": {"zero": false}},
    "color": {"field": "citizenship", "type": "nominal",
              "scale": {"range": ["#4C78A8", "#E45756"]},
              "title": "Citizenship"},
    "tooltip": [
      {"field": "year", "type": "ordinal"},
      {"field": "citizenship", "type": "nominal"},
      {"field": "median_salary", "type": "quantitative", "format": "$,.0f"}
    ]
  },
  "width": 520, "height": 300
}