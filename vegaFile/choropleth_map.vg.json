{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median personal income by SA4 region",
    "subtitle": ["AUD per year, source: ABS 2022–23"],
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#546e7a",
    "anchor": "start",
    "offset": 12
  },
  "width": "container",
  "height": 550,
  "params": [
    {
      "name": "cityView",
      "value": "Australia",
      "bind": {
        "input": "select",
        "name": "Zoom to: ",
        "options": ["Australia", "Sydney", "Melbourne", "Brisbane", "Perth", "Adelaide", "Canberra", "Hobart", "Darwin"]
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "cityView === 'Sydney' ? [151.10, -33.87] : cityView === 'Melbourne' ? [144.96, -37.81] : cityView === 'Brisbane' ? [153.02, -27.47] : cityView === 'Perth' ? [115.86, -31.95] : cityView === 'Adelaide' ? [138.60, -34.93] : cityView === 'Canberra' ? [149.13, -35.28] : cityView === 'Hobart' ? [147.33, -42.88] : cityView === 'Darwin' ? [130.84, -12.46] : [134.00, -28.00]"
    },
    "scale": {
      "expr": "cityView === 'Australia' ? 700 : cityView === 'Canberra' ? 40000 : cityView === 'Sydney' ? 30000 : cityView === 'Adelaide' ? 30000 : cityView === 'Hobart' ? 40000 : cityView === 'Darwin' ? 35000 : 20000"
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/Data/SA4_2026_AUST_GDA2020.json",
    "format": {"type": "topojson", "feature": "SA4_2026_AUST_GDA2020"}
  },
  "transform": [
    {
      "lookup": "properties.SA4_CODE26",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/abs_sa4_wide_2023.csv",
          "format": {"parse": {"code": "string"}}
        },
        "key": "code",
        "fields": ["median"]
      }
    }
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.3},
  "encoding": {
    "color": {
        "field": "median",
        "type": "quantitative",
        "title": "Median income (AUD)",
        "scale": {
          "scheme": "blues",
          "domain": [45000, 78000]
        },
        "legend": {
          "format": "$,.0f",
          "orient": "right",
          "gradientLength": 260,
          "titleFontSize": 12,
          "labelFontSize": 11
        }
      },
    "tooltip": [
      {"field": "properties.SA4_NAME26", "type": "nominal", "title": "Region"},
      {"field": "properties.STE_NAME26", "type": "nominal", "title": "State"},
      {"field": "median", "type": "quantitative", "format": "$,.0f", "title": "Median income"}
    ]
  }
}