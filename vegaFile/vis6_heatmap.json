{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 480,
  "title": {"text": "Salary by field × year", "subtitle": "Undergraduate · broad fields · median starting salary (AUD)"},
  "data": {"url": "Data/salary_by_area.csv"},
  "transform": [
    {"filter": "datum.course_level == 'UG' && datum.study_area_level == 'broad' && datum.gender == 'Total'"}
  ],
  "mark": {"type": "rect", "stroke": "white", "strokeWidth": 1},
  "encoding": {
    "y": {"field": "study_area", "type": "nominal", "title": null, "axis": {"labelLimit": 400}},
    "x": {"field": "year", "type": "ordinal", "title": "Year", "axis": {"labelAngle": 0}},
    "color": {"field": "median_salary", "type": "quantitative",
              "title": "Salary (AUD)", "scale": {"scheme": "magma"}, "legend": {"format": "$,.0f"}},
    "tooltip": [
      {"field": "study_area"}, {"field": "year", "type": "ordinal"},
      {"field": "median_salary", "type": "quantitative", "format": "$,.0f"}
    ]
  }
}