{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 700,
  "padding": {
    "right": 5,
    "left": 5,
    "bottom": 40
  },
  "title": {
    "text": "Which fields are strongest on each side? Balance is not everything",
    "subtitle": "Undergraduate 2025, rank position on three measures, source: QILT GOS",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#546e7a",
    "anchor": "start",
    "offset": 12
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/bump_data.csv",
    "format": {
      "parse": {
        "raw": "number",
        "norm": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "trim(replace(datum.study_area, /\\u00a0/g, ' '))",
      "as": "study_area_clean"
    },
    {
      "filter": "datum.measure == 'Salary' || datum.measure == 'FTE' || datum.measure == 'Overqualified'"
    },
    {
      "calculate": "indexof(['Salary', 'FTE', 'Overqualified'], datum.measure)",
      "as": "mIdx"
    },
    {
      "calculate": "['High salary', 'High FTE', 'Low overqualification'][datum.mIdx]",
      "as": "mLabel"
    },
    {
      "calculate": "datum.measure === 'Overqualified' ? 1 - datum.norm : datum.norm",
      "as": "rankScore"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "rankScore",
          "order": "descending"
        },
        {
          "field": "study_area_clean",
          "order": "ascending"
        }
      ],
      "groupby": ["measure"]
    }
  ],
  "encoding": {
    "x": {
      "field": "mLabel",
      "type": "ordinal",
      "sort": [
        "High salary",
        "High FTE",
        "Low overqualification"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": 600
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank (1 = best)",
      "scale": {
        "reverse": true,
        "domain": [0.5, 21.5]
      },
      "axis": {
        "values": [1, 5, 10, 15, 21],
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },
    "detail": {
      "field": "study_area_clean",
      "type": "nominal"
    },
    "color": {
      "field": "study_area_clean",
      "type": "nominal",
      "scale": {
  "domain": [
    "Agriculture and environmental studies",
    "Architecture and built environment",
    "Business and management",
    "Communications",
    "Computing and information systems",
    "Creative arts",
    "Dentistry",
    "Engineering",
    "Health services and support",
    "Humanities, culture and social sciences",
    "Law and paralegal studies",
    "Medicine",
    "Nursing",
    "Pharmacy",
    "Psychology",
    "Rehabilitation",
    "Science and mathematics",
    "Social work",
    "Teacher education",
    "Tourism, hospitality, personal services, sport and recreation",
    "Veterinary science"
  ],
  "range": [
    "#00204d", 
    "#1f78b4", 
    "#a6cee3", 
    "#4a148c", 
    "#7b3294", 
    "#c2a5cf", 
    "#9c27b0", 
    "#f7b6d2", 
    "#b2182b", 
    "#d6604d", 
    "#f4a582", 
    "#fddbc7", 
    "#ff7f00", 
    "#ffbb78", 
    "#e3b505", 
    "#ffeb3b", 
    "#4dd0e1", 
    "#000000", 
    "#7f7f7f", 
    "#bdbdbd", 
    "#8c564b"
  ]
},
      "legend": {
        "title": "Area of study",
        "orient": "bottom",
        "columns": 3,
        "labelLimit": 300,
        "titleFontSize": 12,
        "labelFontSize": 10,
        "symbolSize": 80,
        "symbolStrokeWidth": 3
      }
    },
    "order": {
      "field": "mIdx",
      "type": "quantitative"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 1,
        "interpolate": "monotone"
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 280,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "study_area_clean",
            "type": "nominal",
            "title": "Field"
          },
          {
            "field": "mLabel",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank"
          },
          {
            "field": "raw",
            "type": "quantitative",
            "format": ",.1f",
            "title": "Raw value"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 10,
        "fontWeight": "bold",
        "fill": "white",
        "dy": 0.5
      },
      "encoding": {
        "color": {"value": "white"},
        "text": {
          "field": "rank",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
    
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  }
}