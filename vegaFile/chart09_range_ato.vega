{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "The middle 50% of graduate incomes, by years since completion",
  "data": {"url": "data/ato_historical.csv"},
  "transform": [
    {"filter": "course_level == 'Undergraduate'"},
    {"pivot": "percentile", "value": "income", "groupby": ["completion_year","years_since_completion"]}
  ],
  "layer": [
    {"mark": {"type": "rule", "strokeWidth": 3, "color": "#4C78A8", "opacity": 0.6},
     "encoding": {
       "x": {"field": "years_since_completion", "type": "ordinal",
             "title": "Years since completion"},
       "y": {"field": "25th", "type": "quantitative",
             "title": "Income (AUD)", "axis": {"format": "$,.0f"}},
       "y2": {"field": "75th"},
       "tooltip": [
         {"field": "completion_year", "type": "ordinal"},
         {"field": "25th", "type": "quantitative", "format": "$,.0f"},
         {"field": "Median", "type": "quantitative", "format": "$,.0f"},
         {"field": "75th", "type": "quantitative", "format": "$,.0f"}
       ]
     }},
    {"mark": {"type": "point", "filled": true, "size": 120, "color": "#E45756"},
     "encoding": {
       "x": {"field": "years_since_completion", "type": "ordinal"},
       "y": {"field": "Median", "type": "quantitative"},
       "tooltip": [
         {"field": "completion_year", "type": "ordinal"},
         {"field": "Median", "type": "quantitative", "format": "$,.0f"}
       ]
     }}
  ],
  "width": 320, "height": 380
}