{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 170, "height": 120,
  "title": {"text": "Salary trends by field", "subtitle": "Undergraduate 2020–2025 · one panel per field"},
  "data": {"url": "processedData/salary_by_area.csv"},
  "transform": [
    {"filter": "datum.course_level == 'UG' && datum.study_area_level == 'broad' && datum.gender == 'Total'"}
  ],
  "mark": {"type": "line", "strokeWidth": 2, "color": "#0b6e99", "point": true},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "axis": {"labels": false, "ticks": false, "title": null, "grid": false}},
    "y": {"field": "median_salary", "type": "quantitative",
          "axis": {"labels": false, "ticks": false, "title": null, "grid": false},
          "scale": {"zero": false}},
    "row": {"field": "study_area", "type": "nominal", "title": null, "header": {"labelAngle": 0, "labelAlign": "left", "labelFontSize": 10}},
    "tooltip": [
      {"field": "study_area"}, {"field": "year", "type": "ordinal"},
      {"field": "median_salary", "type": "quantitative", "format": "$,.0f"}
    ]
  },
  "resolve": {"scale": {"y": "independent"}}
}