{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 480,
  "title": {
    "text": "Where the earners are — and how unequal",
    "subtitle": "Bubble size = number of earners · colour = Gini coefficient (2022–23)"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/Data/SA4_2026_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "SA4_2026_AUST_GDA2020"}
      },
      "projection": {"type": "mercator", "center": [134, -28], "scale": 700},
      "mark": {"type": "geoshape", "fill": "#f6f7f9", "stroke": "#c8cdd6", "strokeWidth": 0.3}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/abs_sa4_wide_2023.csv"
      },
      "transform": [
        {"lookup": "code",
         "from": {
           "data": {"url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/Data/SA4_2026_AUST_GDA2020.json",
                    "format": {"type": "topojson", "feature": "SA4_2026_AUST_GDA2020"}},
           "key": "properties.SA4_CODE26"
         },
         "as": "geo"}
      ],
      "projection": {"type": "mercator", "center": [134, -28], "scale": 700},
      "mark": {"type": "circle", "opacity": 0.7, "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "geo.properties.lon", "type": "quantitative"},
        "latitude":  {"field": "geo.properties.lat", "type": "quantitative"},
        "size": {"field": "earners", "type": "quantitative",
                 "scale": {"range": [30, 1200]}, "legend": {"title": "Earners"}},
        "color": {"field": "gini", "type": "quantitative",
                  "scale": {"scheme": "redblue", "domain": [0.40, 0.65]},
                  "legend": {"title": "Gini"}},
        "tooltip": [
          {"field": "name", "type": "nominal"},
          {"field": "earners", "type": "quantitative", "format": ",.0f"},
          {"field": "gini", "type": "quantitative", "format": ".3f"}
        ]
      }
    }
  ]
}