{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "padding": {"right": 10, "left": 10, "bottom": 60},
  "title": {
    "text": "How each field's balanced across salary, employment, and job-match",
    "subtitle": [
      "Undergraduate 2025",
      "Position near a vertex leans heavily toward that outcome; a dot near the centre is equally weighted on all three"
    ],
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#546e7a",
    "anchor": "start",
    "offset": 12
  },
  "layer": [
    {
      "data": {
        "values": [
          {"tx": 0,   "ty": 0,     "ord": 1},
          {"tx": 1,   "ty": 0,     "ord": 2},
          {"tx": 0.5, "ty": 0.866, "ord": 3},
          {"tx": 0,   "ty": 0,     "ord": 4}
        ]
      },
      "mark": {"type": "line", "color": "#d0d4d9", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "order": {"field": "ord", "type": "ordinal"}
      }
    },
    {
      "data": {
        "values": [
          {"tx": 0.30, "ty": 0.15, "ord": 1},
          {"tx": 0.5, "ty": 0.55, "ord": 2},
          {"tx": 0.70, "ty": 0.15, "ord": 3},
          {"tx": 0.30, "ty": 0.15, "ord": 4}
        ]
      },
      "mark": {"type": "line", "color": "#a0a8b0", "strokeWidth": 1, "strokeDash": [4, 3]},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "order": {"field": "ord", "type": "ordinal"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/ternary_data.csv",
        "format": {
          "type": "csv",
          "parse": {"Salary": "number", "FTE": "number", "Overqualified": "number",
                    "sSalary": "number", "sFTE": "number", "sNotOver": "number",
                    "tx": "number", "ty": "number"}
        }
      },
      "transform": [
        {"calculate": "trim(replace(datum.study_area, /\\u00a0/g, ' '))", "as": "study_area_clean"}
      ],
      "mark": {"type": "circle", "size": 100, "opacity": 0.85, "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "color": {
          "field": "study_area_clean",
          "type": "nominal",
          "scale": {
            "domain": [
              "Agriculture and environmental studies",
              "Architecture and built environment",
              "Business and management",
              "Communications",
              "Computing and information systems",
              "Creative arts",
              "Dentistry",
              "Engineering",
              "Health services and support",
              "Humanities, culture and social sciences",
              "Law and paralegal studies",
              "Medicine",
              "Nursing",
              "Pharmacy",
              "Psychology",
              "Rehabilitation",
              "Science and mathematics",
              "Social work",
              "Teacher education",
              "Tourism, hospitality, personal services, sport and recreation",
              "Veterinary science"
            ],
            "range": [
              "#00204d", 
              "#1f78b4", 
              "#a6cee3", 
              "#4a148c", 
              "#7b3294", 
              "#c2a5cf", 
              "#9c27b0", 
              "#f7b6d2", 
              "#b2182b", 
              "#d6604d", 
              "#f4a582", 
              "#fddbc7", 
              "#ff7f00", 
              "#ffbb78", 
              "#e3b505", 
              "#ffeb3b", 
              "#4dd0e1", 
              "#000000", 
              "#7f7f7f", 
              "#bdbdbd", 
              "#8c564b"
            ]
          },
          "legend": {
            "title": "Area of study",
            "orient": "bottom",
            "columns": 3,
            "labelLimit": 300,
            "titleFontSize": 12,
            "labelFontSize": 10,
            "symbolSize": 80,
            "symbolStrokeWidth": 3
          }
        },
        "tooltip": [
          {"field": "study_area", "type": "nominal", "title": "Field"},
          {"field": "Salary", "type": "quantitative", "format": "$,.0f", "title": "Median salary"},
          {"field": "FTE", "type": "quantitative", "format": ".1f", "title": "Full-time employment (%)"},
          {"field": "Overqualified", "type": "quantitative", "format": ".1f", "title": "Overqualified (%)"},
          {"field": "sSalary", "type": "quantitative", "format": ".0%", "title": "Salary emphasis"},
          {"field": "sFTE", "type": "quantitative", "format": ".0%", "title": "Employment emphasis"},
          {"field": "sNotOver", "type": "quantitative", "format": ".0%", "title": "Job-match emphasis"}
        ]
      }
    },
    {
      "data": {"values": [{"tx": 0.4892, "ty": 0.0, "label": "Pharmacy"}]},
      "mark": {"type": "text", "fontSize": 11, "fontWeight": 600, "color": "#1a3a5c", "align": "center", "dy": -14},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"tx": 0.9182, "ty": 0.1417, "label": "Creative arts"}]},
      "mark": {"type": "text", "fontSize": 11, "fontWeight": 600, "color": "#1a3a5c", "align": "left", "dx": 14},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"tx": 0.223, "ty": 0.3863, "label": "Psychology"}]},
      "mark": {"type": "text", "fontSize": 11, "fontWeight": 600, "color": "#1a3a5c", "align": "right", "dx": -14},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"tx": 0.5498, "ty": 0.3174, "label": "Dentistry"}]},
      "mark": {"type": "text", "fontSize": 11, "fontWeight": 600, "color": "#1a3a5c", "align": "left", "dx": 14, "dy": -4},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"tx": 0.5, "ty": 0.2887, "label": "Balanced zone"}]},
      "mark": {"type": "text", "fontSize": 10, "fontStyle": "italic", "color": "#6b7280", "align": "center", "dy": -6},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"tx": 0.5, "ty": 0.92, "label": "↑ Salary-leaning"}]},
      "mark": {"type": "text", "fontSize": 12, "fontWeight": 600, "color": "#37474f", "align": "center", "baseline": "bottom"},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"tx": -0.04, "ty": -0.03, "label": "↑ Employment-leaning"}]},
      "mark": {"type": "text", "fontSize": 12, "fontWeight": 600, "color": "#37474f", "align": "right", "baseline": "top"},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"tx": 1.04, "ty": -0.03, "label": "↑ Job-match-leaning"}]},
      "mark": {"type": "text", "fontSize": 12, "fontWeight": 600, "color": "#37474f", "align": "left", "baseline": "top"},
      "encoding": {
        "x": {"field": "tx", "type": "quantitative", "axis": null, "scale": {"domain": [-0.14, 1.14]}},
        "y": {"field": "ty", "type": "quantitative", "axis": null, "scale": {"domain": [-0.06, 0.98]}},
        "text": {"field": "label"}
      }
    }
  ]
}