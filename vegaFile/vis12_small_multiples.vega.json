{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Six fields, same story: steady salary growth 2020–2025",
    "subtitle": [
      "Undergraduate median starting salary · broad fields · AUD",
      "All panels share the same y-scale · heights are directly comparable"
    ],
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#546e7a",
    "anchor": "start",
    "offset": 12
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/main/processedData/salary_by_area.csv",
    "format": {"type": "csv", "parse": {"year": "number", "median_salary": "number"}}
  },
  "transform": [
    {"filter": "datum.course_level == 'UG' && datum.study_area_level == 'broad' && datum.gender == 'Total'"},
    {
      "calculate": "indexof(['Dentistry','Medicine','Engineering','Law and paralegal studies','Nursing','Creative arts'], datum.study_area)",
      "as": "panelOrder"
    },
    {"filter": "datum.panelOrder >= 0"}
  ],
  "facet": {
    "row": {
      "field": "study_area",
      "type": "nominal",
      "title": null,
      "sort": {"field": "panelOrder", "order": "ascending"},
      "header": {
        "labelFontSize": 12,
        "labelFontWeight": 600,
        "labelOrient": "left",
        "labelAnchor": "start",
        "labelPadding": 8,
        "labelColor": "#37474f"
      }
    },
    "columns": 3
  },
  "spec": {
    "width": 200,
    "height": 130,
    "layer": [
      {
        "mark": {
          "type": "line",
          "strokeWidth": 2.2,
          "color": "#1e88e5",
          "interpolate": "monotone",
          "point": {"filled": true, "size": 45, "fill": "#1e88e5", "stroke": "white", "strokeWidth": 1}
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal",
            "title": null,
            "axis": {
              "labelAngle": 0,
              "labelFontSize": 10,
              "grid": false,
              "tickSize": 3,
              "labelColor": "#546e7a"
            }
          },
          "y": {
            "field": "median_salary",
            "type": "quantitative",
            "title": null,
            "scale": {"zero": false, "domain": [50000, 105000]},
            "axis": {
              "format": "$,.0f",
              "labelFontSize": 10,
              "grid": true,
              "gridColor": "#f0f0f0",
              "labelColor": "#546e7a"
            }
          },
          "tooltip": [
            {"field": "study_area", "type": "nominal", "title": "Field"},
            {"field": "year", "type": "ordinal", "title": "Year"},
            {"field": "median_salary", "type": "quantitative", "format": "$,.0f", "title": "Median salary"}
          ]
        }
      }
    ]
  },
  "config": {
    "view": {"stroke": null}
  }
}