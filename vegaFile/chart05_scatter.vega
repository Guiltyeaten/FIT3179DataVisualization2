{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Do the highest-paid fields also have the highest employment?",
  "data": {"url": "data/salary_vs_fte.csv"},
  "transform": [
    {"filter": "study_area != 'Total'"}
  ],
  "layer": [
    {"mark": {"type": "point", "filled": true, "size": 120, "opacity": 0.8,
              "color": "#4C78A8"},
     "encoding": {
       "x": {"field": "median_salary", "type": "quantitative",
             "title": "Median salary (AUD)", "axis": {"format": "$,.0f"},
             "scale": {"zero": false}},
       "y": {"field": "fte", "type": "quantitative",
             "title": "Full-time employment rate (%)",
             "scale": {"zero": false}},
       "tooltip": [
         {"field": "study_area", "type": "nominal"},
         {"field": "median_salary", "type": "quantitative", "format": "$,.0f"},
         {"field": "fte", "type": "quantitative", "format": ".1f"}
       ]
     }},
    {"mark": {"type": "text", "dy": -8, "fontSize": 9, "color": "#333"},
     "encoding": {
       "x": {"field": "median_salary", "type": "quantitative"},
       "y": {"field": "fte", "type": "quantitative"},
       "text": {"field": "study_area", "type": "nominal"}
     }}
  ],
  "width": 520, "height": 360
}