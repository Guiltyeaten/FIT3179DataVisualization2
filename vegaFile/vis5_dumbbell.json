{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 520,
  "title": {"text": "Gender pay gap by field", "subtitle": "Undergraduate, 2025 · red line = female, blue dot = male"},
  "data": {"url": "Data/salary_by_area.csv"},
  "transform": [
    {"filter": "datum.year == 2025 && datum.course_level == 'UG' && datum.study_area_level == 'broad' && (datum.gender == 'Male' || datum.gender == 'Female')"},
    {"pivot": "gender", "value": "median_salary", "groupby": ["study_area"]},
    {"filter": "isValid(datum.Male) && isValid(datum.Female)"}
  ],
  "layer": [
    {"mark": {"type": "rule", "strokeWidth": 2, "color": "#ccc"},
     "encoding": {
       "y": {"field": "study_area", "type": "nominal", "sort": "-Male", "title": null, "axis": {"labelLimit": 400}},
       "x": {"field": "Female", "type": "quantitative"},
       "x2": {"field": "Male"}
     }},
    {"mark": {"type": "point", "filled": true, "size": 130, "color": "#4c78a8"},
     "encoding": {
       "y": {"field": "study_area", "type": "nominal", "sort": "-Male"},
       "x": {"field": "Male", "type": "quantitative",
             "title": "Median starting salary (AUD)", "scale": {"domain": [55000, 110000]}, "axis": {"format": "$,.0f"}},
       "tooltip": [{"field": "study_area"}, {"field": "Male", "type": "quantitative", "format": "$,.0f", "title": "Male"}]
     }},
    {"mark": {"type": "point", "filled": true, "size": 130, "color": "#e45756"},
     "encoding": {
       "y": {"field": "study_area", "type": "nominal", "sort": "-Male"},
       "x": {"field": "Female", "type": "quantitative"},
       "tooltip": [{"field": "study_area"}, {"field": "Female", "type": "quantitative", "format": "$,.0f", "title": "Female"}]
     }}
  ]
}