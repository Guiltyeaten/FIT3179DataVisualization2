{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 380,
  "title": {"text": "Salary distribution across universities", "subtitle": "Undergraduate 2025 · each dot is one university"},
  "data": {"url": "https://raw.githubusercontent.com/Guiltyeaten/FIT3179DataVisualization2/refs/heads/main/processedData/institution_outcomes.csv"},
  "transform": [
    {"filter": "datum.year == 2025 && datum.metric == 'salary'"},
    {"calculate": "datum.course_level + random() * 0.0", "as": "yBase"},
    {"calculate": "random() * 0.6 - 0.3", "as": "jitter"}
  ],
  "mark": {"type": "circle", "size": 90, "opacity": 0.7, "filled": true},
  "encoding": {
    "x": {"field": "value", "type": "quantitative", "title": "Median starting salary (AUD)",
          "axis": {"format": "$,.0f"}},
    "y": {"field": "course_level", "type": "nominal", "title": null,
          "axis": {"labelAngle": 0, "labelPadding": 12}},
    "yOffset": {"field": "jitter", "type": "quantitative", "scale": {"domain": [-0.3,0.3], "range": [-25,25]}},
    "color": {"field": "course_level", "type": "nominal", "legend": null,
              "scale": {"range": ["#0b6e99", "#f2a54a"]}},
    "tooltip": [
      {"field": "institution"}, {"field": "course_level"},
      {"field": "value", "type": "quantitative", "format": "$,.0f", "title": "Salary"}
    ]
  }
}