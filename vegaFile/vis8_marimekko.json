{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 480,
  "title": {"text": "Employment composition by field", "subtitle": "Undergraduate 2025 · widths proportional to full-time employment rate"},
  "data": {"url": "processedData/employment_by_area.csv"},
  "transform": [
    {"filter": "datum.year == 2025 && datum.course_level == 'UG' && datum.measure == 'FTE'"},
    {"calculate": "datum.value", "as": "fte"},
    {"joinaggregate": [{"op": "sum", "field": "fte", "as": "total"}]},
    {"calculate": "datum.fte / datum.total", "as": "width"}
  ],
  "mark": {"type": "bar"},
  "encoding": {
    "x": {"field": "study_area", "type": "nominal", "title": null, "axis": {"labelAngle": -40, "labelLimit": 200}},
    "y": {"field": "value", "type": "quantitative", "title": "% employed full-time", "scale": {"domain": [0, 100]}},
    "color": {"field": "value", "type": "quantitative", "scale": {"scheme": "tealblues"}, "legend": null},
    "tooltip": [
      {"field": "study_area"}, {"field": "value", "type": "quantitative", "format": ".1f", "title": "FTE %"}
    ]
  }
}